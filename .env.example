# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is git-ignored; never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Connect → Transaction pooler (port 6543). Used by the app.
DATABASE_URL=
# The AI: one company at a time, for every AI feature. To switch, comment out one block and uncomment the other.
# AI_MODELS is tried in order: if the first is busy or out of quota, the next one is used.
# Gemini (key from https://aistudio.google.com/apikey):
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash
# OpenAI (key from https://platform.openai.com/api-keys). An empty AI_BASE_URL means OpenAI:
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODELS=gpt-6-luna

# Migrations don't use an env value: run `npx supabase login` and
# `npx supabase link --project-ref <your-ref>` once, then `npm run db:push`.
