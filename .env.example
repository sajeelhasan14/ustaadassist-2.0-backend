# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is git-ignored; never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Connect → Transaction pooler (port 6543). Used by the app.
DATABASE_URL=

# Migrations don't use an env value: run `npx supabase login` and
# `npx supabase link --project-ref <your-ref>` once, then `npm run db:push`.
